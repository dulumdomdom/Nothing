        <mxCell id="sys_asu" value="АСУ&#10;(АСУ ТП / АСУП)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="280" height="90" as="geometry" />
