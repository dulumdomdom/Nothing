<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" type="device">
  <diagram id="integration" name="Интеграция и протоколы">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MDM-система ММЗ — Интеграция с системами и протоколы обмена" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Интеграционный слой обеспечивает двусторонний обмен НСИ между MDM и системами 1С, АСУ и Базой инструментов (Imbase)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="350" y="65" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- SYSTEMS -->
        <mxCell id="sys_1c" value="1С&#10;(ERP / УПП)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="280" height="90" as="geometry" />
