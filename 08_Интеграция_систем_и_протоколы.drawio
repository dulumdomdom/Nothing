          <mxGeometry x="880" y="250" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="RabbitMQ • Apache Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="250" width="230" height="60" as="geometry" />
