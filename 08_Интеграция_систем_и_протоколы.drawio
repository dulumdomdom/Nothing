        <mxCell id="c5" value="XML • JSON • CSV • TXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="210" height="60" as="geometry" />
