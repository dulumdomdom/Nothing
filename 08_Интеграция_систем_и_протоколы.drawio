        <mxCell id="sys_imb" value="База инструментов (Imbase)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- INTEGRATION LAYER -->
        <mxCell id="bus_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="190" width="960" height="230" as="geometry" />
        </mxCell>
        <mxCell id="bus_title" value="ИНТЕГРАЦИОННЫЙ СЛОЙ MDM" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="420" y="198" width="920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="REST API • SOAP API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="COM-объекты • T-SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="250" width="210" height="60" as="geometry" />
        </mxCell>
