        <mxCell id="ed2no" value="НЕТ — ожидание остальных шагов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="D2" target="M2">
