        <!-- NOTE -->
        <mxCell id="note1" value="Обходной лист — это накопительная ведомость классификации.&#10;Каждый модератор отвечает только за свой классификатор.&#10;Пока хотя бы один обязательный классификатор не присвоен —&#10;новый элемент не появляется в справочнике. Все переходы статусов&#10;сопровождаются уведомлениями во внутренней почте." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffff88;strokeColor=#36393d;size=18;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
