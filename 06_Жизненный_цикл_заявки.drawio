        <mxCell id="t20" value="отозвать заявку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="st_sent" target="st_withdraw">
