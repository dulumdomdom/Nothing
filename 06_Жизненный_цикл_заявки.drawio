<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" type="device">
  <diagram id="state-req" name="Жизненный цикл заявки">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MDM-система ММЗ — Жизненный цикл заявки (статусы и переходы)" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Каждый переход сопровождается уведомлением во внутренней почте и записью в журнале. История изменений сохраняется по версиям." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="300" y="65" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- STATES -->
        <mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_draft" value="Черновик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="165" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_sent" value="Отправлена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="165" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_mod" value="На модерации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="165" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_class" value="Ожидание классификации&#10;(обходной лист в процессе)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_appr" value="Согласована&#10;(все классификаторы присвоены)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_pub" value="Опубликована&#10;(элемент в справочнике)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#548235;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="165" width="240" height="80" as="geometry" />
