        <mxCell id="t7" value="все классификаторы&#10;присвоены" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="st_class" target="st_appr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t8" value="публикация элемента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#548235;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="st_appr" target="st_pub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t9" value="завершение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_pub" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t10" value="вернуть на доработку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="st_mod" target="st_return"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t11" value="исправить и сохранить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="st_return" target="st_draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t12" value="отклонить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="st_mod" target="st_reject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t13" value="отклонить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="st_class" target="st_reject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t14" value="автор обжалует" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="st_reject" target="st_appeal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t15" value="без обжалования / срок истёк" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="st_reject" target="st_archive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t16" value="эскалация администратору" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="st_appeal" target="st_arb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t17" value="повторное рассмотрение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=11;dashed=1;" edge="1" parent="1" source="st_appeal" target="st_mod">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="635" /><mxPoint x="740" y="235" /></Array></mxGeometry>
