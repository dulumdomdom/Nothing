        <!-- TRANSITIONS -->
        <mxCell id="t1" value="создать" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="start" target="st_draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t2" value="оправить на модерацию" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="st_draft" target="st_sent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t3" value="регистрация в системе" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="st_sent" target="st_mod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t4" value="требуется классификация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="st_mod" target="st_class"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t5" value="классификация не требуется" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="st_mod" target="st_appr">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="200" /><mxPoint x="1250" y="360" /></Array></mxGeometry>
