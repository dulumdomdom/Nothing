        <mxCell id="t6" value="шаг обходного листа выполнен&#10;(ещё не все)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=11;dashed=1;" edge="1" parent="1" source="st_class" target="st_class">
