        <mxCell id="st_return" value="Возвращена на доработку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="200" height="70" as="geometry" />
