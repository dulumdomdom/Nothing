        </mxCell>
        <mxCell id="t21" value="удалить черновик" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="st_draft" target="st_withdraw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t22" value="версионирование / устаревание" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="st_pub" target="st_archive">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="205" /><mxPoint x="1340" y="495" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="note1" value="Особенности:&#10;• Заявка может содержать несколько классификаторов (обходной лист).&#10;• Статус «Ожидание классификации» — накопительный: финальный переход&#10;  возможен только когда все обязательные шаги выполнены.&#10;• Обжалование доступно автору после отклонения; арбитраж — администратору.&#10;• Любое изменение элемента создаёт новую версию в истории." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffff88;strokeColor=#36393d;size=18;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="720" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Цвет статуса:&#10;серый — подготовка/закрытие, синий — регистрация,&#10;оранжевый/жёлтый — в работе у модераторов,&#10;зелёный — успех/публикация, красный — отказ/обжалование,&#10;фиолетовый — арбитраж администратора." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="1050" y="600" width="420" height="120" as="geometry" />
        </mxCell>
      </root>
