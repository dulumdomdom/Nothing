        <mxCell id="st_reject" value="Отклонена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="460" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_appeal" value="Обжалование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
