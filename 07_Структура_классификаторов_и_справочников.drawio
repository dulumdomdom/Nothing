        <mxCell id="vser" value="Использование всероссийских классификаторов: ОКПД, ОКВЭД и др." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="940" width="820" height="60" as="geometry" />
