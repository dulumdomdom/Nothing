        <mxCell id="cls_title" value="КЛАССИФИКАТОР (фасетная структура шифра)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
