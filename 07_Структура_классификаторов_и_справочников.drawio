<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" type="device">
  <diagram id="struct" name="Структура справочников и классификаторов">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MDM-система ММЗ — Структура справочников и классификаторов" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Слева — модель справочника (НСИ), справа — фасетная модель классификатора (шифр и расшифровка)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="400" y="65" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- LEFT PANEL -->
        <mxCell id="left_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fb;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="780" height="930" as="geometry" />
        </mxCell>
        <mxCell id="ref_title" value="СПРАВОЧНИК (нормативно-справочная информация)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="740" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ref_elem" value="Элемент справочника&#10;(иерархия: группы ↔ элементы; перенос между группами)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="215" width="740" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ref_attr" value="Атрибуты (произвольное количество):&#10;1. Числовые (целые, дробные)&#10;2. Строковые&#10;3. Дата и время&#10;4. Файлы (BLOB)&#10;5. Пользовательские / составные типы&#10;6. Ссылочный тип на другой справочник" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="295" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ref_conf" value="Конфигурирование:&#10;• Список состояний элементов (свой на каждый справочник)&#10;• Режим иерархии&#10;• Разграничение доступа по группам:&#10;   – на уровне столбцов&#10;   – на уровне строк" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="295" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ref_hist" value="История редактирования&#10;3 типа истории (приложение №1 к ТЗ):&#10;версии элемента, откат, просмотр" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="495" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ref_ops" value="Операции с элементом:&#10;добавление • редактирование • удаление •&#10;перенос между группами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="495" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ref_search" value="Поиск элементов:&#10;контекстный • неточный • по маске" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="635" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ref_match" value="Сопоставление элементов:&#10;синонимы • аналоги • давальческие •&#10;сертифицированные и др." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="635" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ref_check" value="Сверка наименований с внешними базами НСИ:&#10;«Техэксперт» • реестр ФНС • ФГИС «Аршин» • Кладар и др." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="775" width="740" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ref_note" value="Ограничение доступа реализуется совместно с ролями:&#10;модератор видит и меняет только закреплённый контур НСИ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffff88;strokeColor=#36393d;size=18;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="875" width="740" height="150" as="geometry" />
        </mxCell>

        <!-- RIGHT PANEL -->
