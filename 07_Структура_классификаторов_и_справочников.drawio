        <mxCell id="nst1" value="Нода структуры шифра&#10;(дерево фасетов)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="430" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nst2" value="Нода структуры шифра" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="430" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="facet1" value="Фасет 1&#10;строка шифра" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="540" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="facet2" value="Фасет 2&#10;динамические свойства&#10;«С&lt;Имя свойства&gt;»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1065" y="540" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="facet3" value="Фасет N&#10;(последний = остаток)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="540" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="facet_props" value="Свойства фасета:&#10;• буквенно-цифровой шифр в одну строку&#10;• длина (по умолчанию 1) или символы окончания&#10;• символ начала фасета&#10;• обязательность атрибута" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="520" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cond" value="Условия перехода между дочерними фасетами&#10;(если у ветви несколько дочерних — выбирается по условию,&#10;иначе берётся первая дочерняя нода):&#10;string • int • float • bool&#10;int range • float range&#10;string/int/float/bool array&#10;int/float range array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="410" height="150" as="geometry" />
        </mxCell>
        <mxCell id="decode" value="РАСШИФРОВКА&#10;1. Указать название каталога и шифр&#10;2. Выбрать структуру: первая, для которой выполнены все условия, либо по умолчанию&#10;3. Расшифровать значения всех фасетов и объединить их через пробел" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1340" y="650" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rtl" value="Шифр читается СПРАВА НАЛЕВО. Шифр и расшифровка могут частично зависеть друг от друга; шифр не всегда зависит от расшифровки." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="840" width="820" height="70" as="geometry" />
